    {
        "id": "1d075d1d019512f7",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "To Python Command",
        "func": "// ModeActor -> Node-RED: UDP to Contiki + HTTP response to Akka\nconst body = msg.payload || {};\nconst moteId = body.moteId;\nconst newT = (typeof body.newT !== 'undefined') ? body.newT\n    : (typeof body.periodT !== 'undefined') ? body.periodT\n        : (typeof body.newTStr !== 'undefined') ? parseInt(body.newTStr, 10)\n            : undefined;\n\nif (typeof newT === 'undefined' || Number.isNaN(Number(newT))) {\n    node.warn(\"Missing or invalid newT/periodT in payload: \" + JSON.stringify(body));\n    const errMsg = RED.util.cloneMessage(msg);\n    errMsg.payload = { error: \"missing newT/periodT\" };\n    errMsg.statusCode = 400;\n    return [null, errMsg];\n}\n\n// Output 1: UDP — JSON string (Contiki does json.loads on the packet)\nconst udpMsg = RED.util.cloneMessage(msg);\nudpMsg.payload = JSON.stringify({\n    action: \"SET_PERIOD\",\n    value: Number(newT),\n    moteId: moteId\n});\n\n// Output 2: HTTP response — clone keeps req/res (fixes \"No response object\")\nconst resp = RED.util.cloneMessage(msg);\nresp.payload = { status: \"ok\" };\nresp.statusCode = 200;\n\nreturn [udpMsg, resp];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
